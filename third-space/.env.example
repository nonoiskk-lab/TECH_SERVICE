# --- Database (Postgres; Supabase in production) ---------------------------
DATABASE_URL="postgresql://thirdspace:thirdspace@localhost:5432/thirdspace"

# --- Admin panel (/admin) ---------------------------------------------------
# Shared staff password; each person also types their name, which goes into the audit log.
ADMIN_PASSWORD=
# Long random string (16+ characters) used to sign staff sessions and hash OTP codes.
AUTH_SECRET=

# --- Legal Gate -------------------------------------------------------------
# "closed" (default) hides every Theatre/film offer; "open" only once the licence is in place.
THIRD_SPACE_LEGAL_GATE=closed

# --- Policy pack v2.0 ---------------------------------------------------------
# "draft" shows a "Draft under legal review" note on policy pages; "final" after advocate approval.
POLICY_STATUS=draft
POLICY_EFFECTIVE_DATE=
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_DESIGNATION=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=
GRIEVANCE_POSTAL_ADDRESS=

# --- Public contact details (hidden until set; never shown as placeholders) --
THIRD_SPACE_PHONE=
THIRD_SPACE_WHATSAPP=
THIRD_SPACE_EMAIL=
THIRD_SPACE_ADDRESS_LINE=
THIRD_SPACE_MAP_URL=

# --- Payments: leave empty for the mock (no money moves) --------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- OTP: "mock" shows code 123456 on screen; "sms" needs a provider (not wired yet)
OTP_MODE=mock

# Canonical origin used in sitemap, canonical links, JSON-LD and confirmation links.
SITE_URL=http://localhost:3000
