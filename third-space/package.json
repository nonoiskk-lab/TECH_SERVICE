{
  "name": "third-space-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test:unit": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://thirdspace:thirdspace@localhost:5432/thirdspace_test} vitest run",
    "test:e2e": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://thirdspace:thirdspace@localhost:5432/thirdspace_test} prisma migrate deploy && playwright test --trace off",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
