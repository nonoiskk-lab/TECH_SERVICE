# Legal Gate: "closed" (default) hides every Theatre/film offer; "open" shows Theatre normally.
THIRD_SPACE_LEGAL_GATE=closed

# Public contact details. Leave empty until the owner confirms them; the site hides
# phone/WhatsApp/email blocks that are empty instead of showing a placeholder.
THIRD_SPACE_PHONE=
THIRD_SPACE_WHATSAPP=
THIRD_SPACE_EMAIL=
THIRD_SPACE_ADDRESS_LINE=
THIRD_SPACE_MAP_URL=

# Canonical origin used in sitemap, canonical links and JSON-LD.
SITE_URL=http://localhost:3000
