// THIRD SPACE booking software. Postgres (Supabase in production, any
// Postgres locally). Prices and rules live in src/config, not here: the DB
// stores what happened (bookings, acceptances, incidents, audit trail).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A booking. Status: pending_payment | confirmed | checked_in | in_progress | completed |
/// cancelled | refund_pending | refunded | no_show | stopped
model Booking {
  id               String    @id // TS-XXXXXX
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  packageName      String    @default("")
  subtotal         Int       @default(0)
  discount         Int       @default(0)
  couponCode       String?
  tax              Int       @default(0)
  specialRequests  String    @default("")
  source           String    @default("web") // web | admin
  holdId           String?
  rescheduledFrom  DateTime?
  rescheduleCount  Int       @default(0)
  accessToken      String    @unique // secret for the guest's confirmation link
  packageId        String
  service          String // theatre | podcast | creator | visit
  mode             String // watch | create | celebrate | visit
  resource         String // room | studio
  start            DateTime
  end              DateTime
  addOnIds         String[]
  themeId          String?
  /// Theatre: the licensed title chosen (name copied for the record)
  titleId          String?
  titleName        String?
  /// What the guest asked for (episodes, reels, hours…); time and price were derived from it
  sessionInput     Json?
  durationMinutes  Int       @default(0)
  guestName        String
  guestPhone       String
  guestEmail       String
  guestCount       Int
  locale           String    @default("en")
  total            Int
  advancePaid      Int
  balanceDue       Int
  status           String    @default("confirmed")
  paymentProvider  String?
  paymentOrderId   String?
  paymentId        String?
  balancePaidAt    DateTime?
  checkedInAt      DateTime?
  /// Minimal age record: how many guests staff saw as 18+. No ID numbers or images.
  ageVerifiedCount Int?
  ageVerifiedBy    String?
  cancelledAt      DateTime?
  cancelReason     String?
  refundAmount     Int?
  utm              Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  acceptance    PolicyAcceptance?
  incidents     Incident[]
  notifications Notification[]
  payments      Payment[]
  recordings    RecordingFile[]
  membershipUse MembershipUsage[]

  @@index([resource, start])
  @@index([start])
}

/// A slot held during checkout. Expired rows are ignored and cleaned up lazily.
model Hold {
  id        String   @id @default(uuid())
  packageId String
  resource  String
  start     DateTime
  end       DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([resource, start])
}

/// Staff-blocked time: maintenance, holiday, private event, deep cleaning.
model SlotBlock {
  id        String   @id @default(uuid())
  kind      String   @default("maintenance") // maintenance | holiday | event
  resource  String
  start     DateTime
  end       DateTime
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@index([resource, start])
}

/// Payment order waiting for the gateway's success callback.
model PendingOrder {
  orderId   String   @id
  holdId    String
  amount    Int
  provider  String
  draft     Json
  createdAt DateTime @default(now())
}

/// Record of the guest's mandatory acceptance (policy section 10).
model PolicyAcceptance {
  id                   String   @id @default(uuid())
  bookingId            String   @unique
  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  policyPackVersion    String
  /// [{ id, title, version }] of every document accepted
  documents            Json
  declarationVersion   String
  /// Exact declaration text shown to the guest at the time of acceptance
  declarationText      String
  locale               String
  /// e.g. "checkbox:declaration" — the affirmative action taken
  action               String
  allParticipantsAdult Boolean
  guestsInformed       Boolean
  venueRulesAccepted   Boolean
  recordingConsent     Boolean?
  /// Optional, separate from the mandatory acceptance
  promotionalConsent   Boolean  @default(false)
  marketingConsent     Boolean  @default(false)
  acceptedAt           DateTime @default(now())
}

model Lead {
  id        String   @id @default(uuid())
  purpose   String
  name      String
  phone     String
  message   String
  source    String
  utm       Json
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())
}

model OtpCode {
  phone         String    @id
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  verifiedUntil DateTime?
}

/// Incident register (policy sections 7 and 8). Objective facts only.
model Incident {
  id                   String    @id @default(uuid())
  bookingId            String?
  booking              Booking?  @relation(fields: [bookingId], references: [id])
  occurredAt           DateTime
  category             String // conduct | prohibited_item | content | safety | medical | property | other
  severity             String // low | medium | high
  description          String
  witnesses            String    @default("")
  actionsTaken         String    @default("")
  sessionStopped       Boolean   @default(false)
  evidencePreserved    Boolean   @default(false)
  authoritiesContacted Boolean   @default(false)
  status               String    @default("open") // open | closed
  reportedBy           String
  closedAt             DateTime?
  createdAt            DateTime  @default(now())
}

/// Append-only trail of every staff and system action.
model AuditLog {
  id       String   @id @default(uuid())
  at       DateTime @default(now())
  actor    String
  action   String
  entity   String
  entityId String?
  details  Json?

  @@index([entity, entityId])
  @@index([at])
}

/// Outbox for booking confirmations. Without a provider, staff send them
/// from the admin panel with a wa.me link.
model Notification {
  id        String    @id @default(uuid())
  kind      String    @default("booking_confirmed")
  sendAfter DateTime  @default(now())
  error     String?
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  channel   String // whatsapp | email
  to        String
  body      String
  status    String    @default("queued") // queued | sent | failed
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model EventCount {
  event String @id
  count Int    @default(0)
}

/// Licensed titles the private room may play. Only staff add these, and only
/// with a valid exhibition licence (policy: Private Theatre addendum).
model Title {
  id             String   @id @default(uuid())
  name           String
  runtimeMinutes Int
  language       String   @default("")
  certification  String   @default("")
  licenceRef     String
  active         Boolean  @default(true)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CATALOGUE (admin-editable)
// ---------------------------------------------------------------------------

model Resource {
  id                String  @id // theatre | studio
  name              String
  openTime          String  @default("10:00")
  closeTime         String  @default("22:00")
  slotStepMinutes   Int     @default(30)
  bufferMinutes     Int     @default(30)
  bookingWindowDays Int     @default(60)
  active            Boolean @default(true)
  sortOrder         Int     @default(0)
}

model Package {
  id                String         @id
  resourceId        String
  category          String // theatre | podcast | celebration | creator | visit
  mode              String // watch | create | celebrate | visit
  service           String // theatre | podcast | creator | celebration | visit
  nameEn            String
  nameHi            String
  summaryEn         String         @default("")
  summaryHi         String         @default("")
  pricingKind       String // fixed | title | podcast | creator | hourly
  startingPrice     Int
  ratePerHour       Int            @default(0)
  durationMinutes   Int
  setupMinutes      Int            @default(30)
  maxGuests         Int
  inclusions        Json           @default("[]") // [{en,hi}] entered by admin
  priceListLabelEn  String         @default("")
  priceListLabelHi  String         @default("")
  priceListNoteEn   String         @default("")
  priceListNoteHi   String         @default("")
  pricePlus         Boolean        @default(false)
  showInPriceList   Boolean        @default(true)
  requiresLegalGate Boolean        @default(false)
  advancePercent    Int? // null = business default
  refundTiers       Json? // null = business default
  planHours         Int?
  planValidityDays  Int?
  active            Boolean        @default(true)
  sortOrder         Int            @default(0)
  updatedAt         DateTime       @updatedAt
  assets            PackageAsset[]
}

model AddOn {
  id        String   @id
  nameEn    String
  nameHi    String
  price     Int
  modes     String[]
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
}

model Coupon {
  code        String    @id
  kind        String // percent | flat
  value       Int
  minSubtotal Int       @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  packageIds  String[]
  validFrom   DateTime?
  validUntil  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

/// Staff member or equipment that more than one resource may need.
model SharedAsset {
  id       String         @id @default(uuid())
  name     String
  kind     String // staff | equipment
  active   Boolean        @default(true)
  packages PackageAsset[]
}

model PackageAsset {
  packageId String
  assetId   String
  package   Package     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  asset     SharedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([packageId, assetId])
}

/// Business settings as key → JSON (tax, advance %, hold minutes, notification timing…).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String   @default("system")
}

// ---------------------------------------------------------------------------
// CUSTOMERS, MEMBERSHIPS, PAYMENTS
// ---------------------------------------------------------------------------

model Customer {
  id                String              @id @default(uuid())
  phone             String              @unique
  name              String
  email             String
  marketingConsent  Boolean             @default(false)
  notes             String              @default("")
  deletionRequested DateTime?
  /// Set when the guest creates an online account (scrypt hash). Null = no account.
  passwordHash      String?
  lastLoginAt       DateTime?
  createdAt         DateTime            @default(now())
  bookings          Booking[]
  memberships       CreatorMembership[]
}

model CreatorMembership {
  id          String            @id @default(uuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  packageId   String
  bookingId   String            @unique
  hoursTotal  Int
  minutesUsed Int               @default(0)
  validUntil  DateTime
  status      String            @default("active") // active | expired | cancelled
  createdAt   DateTime          @default(now())
  usage       MembershipUsage[]
}

model MembershipUsage {
  id           String            @id @default(uuid())
  membershipId String
  membership   CreatorMembership @relation(fields: [membershipId], references: [id])
  bookingId    String?
  booking      Booking?          @relation(fields: [bookingId], references: [id])
  minutes      Int
  note         String            @default("")
  recordedBy   String
  createdAt    DateTime          @default(now())
}

/// One row per money movement. Unique ids prevent duplicate captures.
model Payment {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  provider  String // razorpay | mock | venue | cash | upi | card
  kind      String // advance | balance | full | refund
  orderId   String?  @unique
  paymentId String?  @unique
  refundId  String?  @unique
  amount    Int
  status    String // created | captured | failed | refunded | pending
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id         String   @id // provider event id
  provider   String
  type       String
  receivedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CONTENT, FILES, STAFF, SECURITY
// ---------------------------------------------------------------------------

/// Recording delivered to one booking through an expiring token link.
model RecordingFile {
  id          String    @id @default(uuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  label       String
  url         String // storage URL or external link (never shown before the token check)
  token       String    @unique
  expiresAt   DateTime
  deliveredAt DateTime?
  downloads   Int       @default(0)
  deleteAfter DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  text      String
  source    String // e.g. "Google review, 12 Dec 2026"
  rating    Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(uuid())
  url       String
  alt       String
  category  String   @default("studio")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  role         String // super_admin | studio_manager | booking_manager | finance_manager | staff
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
