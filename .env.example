DATABASE_URL="file:./dev.db"

# Session / auth — generate a long random string for production
AUTH_SECRET="change-me"

# Optional: Twilio WhatsApp Cloud API. If left blank, the app falls back to
# free wa.me deep links that staff click to send from their own WhatsApp.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Public base URL used to build customer status links & QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"
